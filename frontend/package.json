{
  "name": "lllm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx",
    "test": "vitest run",
    "desktop:dev": "electron .",
    "desktop": "npm run build && electron .",
    "build:backend": "..\\backend\\.venv\\Scripts\\python.exe -m PyInstaller --clean --onefile --name lllm-backend --paths ..\\backend --workpath ..\\backend\\build --specpath ..\\backend --distpath ..\\backend\\dist ..\\backend\\sidecar.py",
    "package:win": "npm run build:backend && npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.lllm.app",
    "productName": "LLLM",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/lllm-backend.exe",
        "to": "lllm-backend.exe"
      }
    ],
    "win": {
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        }
      ]
    },
    "nsis": {
      "createDesktopShortcut": true,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Arksol",
        "repo": "lllm"
      }
    ]
  },
  "main": "electron/main.cjs",
  "description": "Large Language Learning Model — analiza repositorios con el modelo que elijas",
  "author": "Aaron Santillan"
}
